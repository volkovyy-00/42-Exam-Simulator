# Copy to .env. Defaults shown. DESIGN.md §9.
# Only `web` loads this file. grader-dispatcher (holds docker.sock) gets just the
# "Grader dispatcher" vars and CONTENT_DIR, via interpolation in docker-compose.yml.
PORT=8042
DATA_DIR=/data
CONTENT_DIR=/content
DISPATCHER_URL=http://grader-dispatcher:9000
COOKIE_SECURE=true
SESSION_SECRET=change-me-to-32-random-bytes
SUBMISSIONS_PER_MIN=6

# Hints (off until grading is solid)
HINTS_ENABLED=false
OPENROUTER_API_KEY=
HINT_MODEL=deepseek/deepseek-v4-flash-0731
HINT_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash-1017,anthropic/claude-haiku-5.5
HINT_DAILY_USD_STOP=2

# Grader dispatcher (passed to it by name in docker-compose.yml; add new ones there)
COMPILE_TIMEOUT_S=10
TEST_TIMEOUT_S=2
TEST_CPU_S=1
SUBMISSION_TIMEOUT_S=30
GRADER_CONCURRENCY=2
GRADER_QUEUE_MAX=20
GRADER_IMAGE=grader:pinned
JOBS_DIR=/srv/grader/jobs
