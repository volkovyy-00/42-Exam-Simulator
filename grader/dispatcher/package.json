{
  "name": "grader-dispatcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "test:grading": "node --test --test-concurrency=1 test/*.test.ts test/grading/*.test.ts"
  },
  "dependencies": {
    "@ceg/contract": "*",
    "fastify": "^5.12.8"
  }
}
